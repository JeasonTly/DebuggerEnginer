<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
  <!-- 与主题无关的 DESIGN.md 排版令牌、共享控件样式、矢量图标（24×24 视口，描边 1.7）。 -->

  <FontFamily x:Key="Font.Ui">Segoe UI, Microsoft YaHei UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

  <system:Double x:Key="FontSize.PageTitle">22</system:Double>
  <system:Double x:Key="FontSize.Body">14</system:Double>
  <system:Double x:Key="FontSize.Secondary">12</system:Double>
  <system:Double x:Key="FontSize.Caption">11</system:Double>

  <CornerRadius x:Key="Radius.Control">6</CornerRadius>
  <CornerRadius x:Key="Radius.Container">8</CornerRadius>

  <!-- ================= 矢量图标 ================= -->
