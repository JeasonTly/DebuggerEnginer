<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- DESIGN.md 浅色令牌。键名与 Dark.xaml 完全一致。 -->

  <Color x:Key="Color.Background">#EEF1F6</Color>
  <Color x:Key="Color.Surface">#F7F9FC</Color>
  <Color x:Key="Color.Raised">#FFFFFF</Color>
  <Color x:Key="Color.Border">#C9D3E0</Color>
  <Color x:Key="Color.Text">#1A2433</Color>
  <Color x:Key="Color.TextSecondary">#5B6B7F</Color>
  <Color x:Key="Color.Accent">#2F6FED</Color>
  <Color x:Key="Color.Success">#1F7A4C</Color>
  <Color x:Key="Color.Warning">#A15C12</Color>
  <Color x:Key="Color.Danger">#C23B4A</Color>
  <!-- 投屏舞台在两种主题下都保持深色 -->
  <Color x:Key="Color.MirrorStage">#0A0E14</Color>

  <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.Raised" Color="{StaticResource Color.Raised}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.MirrorStage" Color="{StaticResource Color.MirrorStage}" />

  <!-- UI 壳扩展令牌（对应原型 accent-dim / accent-text / warn-text / overlay 等） -->
  <Color x:Key="Color.AccentHover">#2558C7</Color>
  <Color x:Key="Color.AccentMuted">#DCE8FF</Color>
  <Color x:Key="Color.AccentText">#2558C7</Color>
  <Color x:Key="Color.OnAccent">#FFFFFF</Color>
  <Color x:Key="Color.WarningText">#81531B</Color>
  <Color x:Key="Color.WarningBg">#2EA15C12</Color>
  <Color x:Key="Color.SuccessText">#1F7A4C</Color>
  <Color x:Key="Color.SuccessBg">#291F7A4C</Color>
  <Color x:Key="Color.DangerBg">#24C23B4A</Color>
  <Color x:Key="Color.Overlay">#73141C28</Color>
  <Color x:Key="Color.Console">#0D1117</Color>
  <Color x:Key="Color.ConsoleInput">#12171F</Color>
  <Color x:Key="Color.ConsoleText">#C9D1D9</Color>
  <Color x:Key="Color.ConsoleInputText">#E6EDF3</Color>
  <Color x:Key="Color.ConsoleBorder">#2A3340</Color>
  <Color x:Key="Color.SystemIcon">#5A6A7E</Color>
  <Color x:Key="Color.CaptionCloseHover">#C42B1C</Color>
  <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
  <SolidColorBrush x:Key="Brush.AccentMuted" Color="{StaticResource Color.AccentMuted}" />
  <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
  <SolidColorBrush x:Key="Brush.WarningText" Color="{StaticResource Color.WarningText}" />
  <SolidColorBrush x:Key="Brush.WarningBg" Color="{StaticResource Color.WarningBg}" />
  <SolidColorBrush x:Key="Brush.SuccessText" Color="{StaticResource Color.SuccessText}" />
  <SolidColorBrush x:Key="Brush.SuccessBg" Color="{StaticResource Color.SuccessBg}" />
  <SolidColorBrush x:Key="Brush.DangerBg" Color="{StaticResource Color.DangerBg}" />
  <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}" />
  <SolidColorBrush x:Key="Brush.Console" Color="{StaticResource Color.Console}" />
  <SolidColorBrush x:Key="Brush.ConsoleInput" Color="{StaticResource Color.ConsoleInput}" />
  <SolidColorBrush x:Key="Brush.ConsoleText" Color="{StaticResource Color.ConsoleText}" />
  <SolidColorBrush x:Key="Brush.ConsoleInputText" Color="{StaticResource Color.ConsoleInputText}" />
  <SolidColorBrush x:Key="Brush.ConsoleBorder" Color="{StaticResource Color.ConsoleBorder}" />
  <SolidColorBrush x:Key="Brush.SystemIcon" Color="{StaticResource Color.SystemIcon}" />
  <SolidColorBrush x:Key="Brush.CaptionCloseHover" Color="{StaticResource Color.CaptionCloseHover}" />
</ResourceDictionary>

