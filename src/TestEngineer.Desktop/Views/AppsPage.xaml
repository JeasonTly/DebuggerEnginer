<UserControl x:Class="TestEngineer.Desktop.Views.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TestEngineer.Desktop.Converters"
             Loaded="OnLoaded">
  <UserControl.Resources>
    <conv:StringEqualsConverter x:Key="StrEq" />
    <conv:PngBytesToImageConverter x:Key="PngImg" />
    <!-- 行尾图标按钮；系统应用（IsSystem）不渲染「授权/卸载」（Collapsed），其列宽固定保证启动/清数据对齐。 -->
    <Style x:Key="RowAction.ThirdPartyOnly" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSystem}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RowAction.ThirdPartyOnlyDanger" TargetType="Button" BasedOn="{StaticResource Button.IconDanger}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSystem}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="AppRowItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="6,6">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.AccentMuted}" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.AccentMuted}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,12,16,10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel>
          <TextBlock Text="应用管理" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Status}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="安装 APK" Margin="0,0,8,0" Style="{StaticResource Button.Primary}" Command="{Binding InstallApkCommand}" />
          <Button Content="刷新" Command="{Binding RefreshCommand}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <DockPanel Margin="16">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
        <Border CornerRadius="6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                Background="{DynamicResource Brush.Surface}" Padding="2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Button Content="第三方" Margin="0,0,2,0" Style="{StaticResource Button.Segment}" Tag="ThirdParty" Click="OnSegmentClick"
                    Selector.IsSelected="{Binding Segment, Converter={StaticResource StrEq}, ConverterParameter=ThirdParty, Mode=OneWay}" />
            <Button Content="系统" Margin="0,0,2,0" Style="{StaticResource Button.Segment}" Tag="System" Click="OnSegmentClick"
                    Selector.IsSelected="{Binding Segment, Converter={StaticResource StrEq}, ConverterParameter=System, Mode=OneWay}" />
            <Button Content="全部" Margin="0,0,2,0" Style="{StaticResource Button.Segment}" Tag="All" Click="OnSegmentClick"
                    Selector.IsSelected="{Binding Segment, Converter={StaticResource StrEq}, ConverterParameter=All, Mode=OneWay}" />
            <Button Content="有图标" Style="{StaticResource Button.Segment}" Tag="HasIcon" Click="OnSegmentClick"
                    Selector.IsSelected="{Binding Segment, Converter={StaticResource StrEq}, ConverterParameter=HasIcon, Mode=OneWay}" />
          </StackPanel>
        </Border>
        <TextBox Margin="12,0,0,0" Height="32" MinWidth="160"
                 VerticalContentAlignment="Center" Padding="8,0" FontSize="14"
                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="搜索应用名或包名" AutomationProperties.Name="搜索应用名或包名" />
      </DockPanel>

      <Border DockPanel.Dock="Bottom" Height="120" Margin="0,12,0,0" Padding="12"
              Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
        <ScrollViewer>
          <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Text="{Binding DetailText}" TextWrapping="Wrap" />
        </ScrollViewer>
      </Border>

      <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
        <ListBox ItemsSource="{Binding FilteredPackages}" SelectedItem="{Binding SelectedPackage}"
                 BorderThickness="0" Background="Transparent"
                 ItemContainerStyle="{StaticResource AppRowItem}"
                 VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8" HorizontalAlignment="Left">
                  <Border.Clip>
                    <RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,36,36" />
                  </Border.Clip>
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSystem}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.SystemIcon}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <Image Stretch="UniformToFill" Source="{Binding IconData, Converter={StaticResource PngImg}}" />
                    <TextBlock Text="{Binding Initial}" Foreground="{DynamicResource Brush.OnAccent}"
                               FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasIcon}" Value="False">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                  <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            Background="{DynamicResource Brush.Raised}" VerticalAlignment="Center">
                      <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding KindLabel}" />
                    </Border>
                    <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                  <TextBlock FontSize="11" Margin="0,2,0,0" FontFamily="Cascadia Mono, Consolas"
                             Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding PackageName}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <!-- 固定宽度操作区：4 × 32 + 3 × 4 = 140，列宽固定，系统应用隐藏后启动/清数据仍对齐 -->
                <Grid Grid.Column="2" Width="140" VerticalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="32" />
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Style="{StaticResource Button.Icon}" ToolTip="启动" AutomationProperties.Name="启动"
                          Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                    <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16" Content="{StaticResource Icon.Action.Launch}" />
                  </Button>
                  <Button Grid.Column="2" Style="{StaticResource Button.Icon}" ToolTip="清数据" AutomationProperties.Name="清数据"
                          Command="{Binding DataContext.ClearDataCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                    <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16" Content="{StaticResource Icon.Action.ClearData}" />
                  </Button>
                  <Button Grid.Column="4" Style="{StaticResource RowAction.ThirdPartyOnly}" ToolTip="一键授权" AutomationProperties.Name="一键授权"
                          Command="{Binding DataContext.GrantAllCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                    <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16" Content="{StaticResource Icon.Action.Grant}" />
                  </Button>
                  <Button Grid.Column="6" Style="{StaticResource RowAction.ThirdPartyOnlyDanger}" ToolTip="卸载" AutomationProperties.Name="卸载"
                          Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                    <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16" Content="{StaticResource Icon.Action.Uninstall}" />
                  </Button>
                </Grid>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </DockPanel>
  </DockPanel>
</UserControl>
