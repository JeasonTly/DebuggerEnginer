<UserControl x:Class="TestEngineer.Desktop.Views.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TestEngineer.Desktop.Converters"
             Loaded="OnLoaded"
             AllowDrop="True"
             Drop="OnDrop"
             DragOver="OnDragOver">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:StringEqualsConverter x:Key="StrEq" />
    <conv:PngBytesToImageConverter x:Key="PngImg" />
    <!-- 系统应用隐藏授权/卸载但占位，保证启动/清数据列对齐 -->
    <Style x:Key="RowAction.ThirdPartyOnly" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSystem}" Value="True">
          <Setter Property="Visibility" Value="Hidden" />
          <Setter Property="IsEnabled" Value="False" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RowAction.ThirdPartyOnlyDanger" TargetType="Button" BasedOn="{StaticResource Button.IconDanger}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSystem}" Value="True">
          <Setter Property="Visibility" Value="Hidden" />
          <Setter Property="IsEnabled" Value="False" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="AppTag" TargetType="Border">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentMuted}" />
    </Style>
    <Style x:Key="AppTagText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    </Style>

    <Style x:Key="AppRowItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="10,6" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.AccentMuted}" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.AccentMuted}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <DockPanel>
    <!-- 页头：标题+固定副标题 | 分段 + 安装 APK -->
    <Border DockPanel.Dock="Top" Padding="16,12,16,10"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
            Background="{DynamicResource Brush.Surface}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Bottom" Margin="0,0,16,0">
          <TextBlock Text="应用管理" Style="{StaticResource Text.PageTitle}" />
          <TextBlock Text="图标优先 · 行内图标操作 · 仅第三方可授权"
                     Style="{StaticResource Text.PageSubtitle}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <Border Margin="0,0,8,0" CornerRadius="6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                  Background="{DynamicResource Brush.Surface}" Padding="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Button Content="有图标" Style="{StaticResource Button.Segment}" Tag="HasIcon" Click="OnSegmentClick"
                      Selector.IsSelected="{Binding Segment, Converter={StaticResource StrEq}, ConverterParameter=HasIcon, Mode=OneWay}"
                      AutomationProperties.Name="筛选有图标" />
              <Button Content="第三方" Style="{StaticResource Button.Segment}" Tag="ThirdParty" Click="OnSegmentClick"
                      Selector.IsSelected="{Binding Segment, Converter={StaticResource StrEq}, ConverterParameter=ThirdParty, Mode=OneWay}"
                      AutomationProperties.Name="筛选第三方" />
              <Button Content="系统" Style="{StaticResource Button.Segment}" Tag="System" Click="OnSegmentClick"
                      Selector.IsSelected="{Binding Segment, Converter={StaticResource StrEq}, ConverterParameter=System, Mode=OneWay}"
                      AutomationProperties.Name="筛选系统" />
              <Button Content="全部" Style="{StaticResource Button.Segment}" Tag="All" Click="OnSegmentClick"
                      Selector.IsSelected="{Binding Segment, Converter={StaticResource StrEq}, ConverterParameter=All, Mode=OneWay}"
                      AutomationProperties.Name="筛选全部" />
            </StackPanel>
          </Border>
          <Button Content="安装 APK" Style="{StaticResource Button.Primary}"
                  Command="{Binding InstallApkCommand}"
                  ToolTip="选择或拖入 APK 安装"
                  AutomationProperties.Name="安装 APK" />
        </StackPanel>
      </DockPanel>
    </Border>

    <DockPanel Margin="16,12,16,16">
      <!-- 工具行：搜索 + 刷新 -->
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="刷新" Margin="8,0,0,0"
                Style="{StaticResource Button.Secondary}"
                Command="{Binding RefreshCommand}"
                AutomationProperties.Name="刷新应用列表" />
        <TextBox Height="32" MinWidth="160"
                 VerticalContentAlignment="Center" Padding="10,0" FontSize="13"
                 Background="{DynamicResource Brush.Raised}"
                 BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="搜索应用名或包名"
                 AutomationProperties.Name="搜索应用名或包名">
          <TextBox.Style>
            <Style TargetType="TextBox">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                      <Grid>
                        <TextBlock Text="搜索应用名或包名…" Margin="2,0,0,0"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </TextBox.Style>
        </TextBox>
      </DockPanel>

      <!-- 列表 -->
      <Border Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
        <Grid>
          <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}"
                   BorderThickness="0" Background="Transparent"
                   ItemContainerStyle="{StaticResource AppRowItem}"
                   VirtualizingPanel.IsVirtualizing="True"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="176" />
                  </Grid.ColumnDefinitions>

                  <!-- 36×36 图标：真实图 / 首字 / 无图标虚线占位 -->
                  <Border Width="36" Height="36" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSystem}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.SystemIcon}" />
                          </DataTrigger>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding HasIcon}" Value="False" />
                              <Condition Binding="{Binding HasLauncher}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <!-- 虚线用 Path 叠层近似；WPF Border 无原生 dash，用额外层 -->
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Grid>
                      <Rectangle RadiusX="8" RadiusY="8" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1"
                                 StrokeDashArray="2 2" Fill="Transparent">
                        <Rectangle.Style>
                          <Style TargetType="Rectangle">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding HasIcon}" Value="False" />
                                  <Condition Binding="{Binding HasLauncher}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                              </MultiDataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Rectangle.Style>
                      </Rectangle>
                      <Border CornerRadius="8" ClipToBounds="True">
                        <Image Stretch="UniformToFill" Source="{Binding IconData, Converter={StaticResource PngImg}}">
                          <Image.Style>
                            <Style TargetType="Image">
                              <Setter Property="Visibility" Value="Visible" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Image.Style>
                        </Image>
                      </Border>
                      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                 FontWeight="Bold" FontSize="12">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding Initial}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding HasIcon}" Value="False" />
                                  <Condition Binding="{Binding HasLauncher}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="—" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                              </MultiDataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </Border>

                  <!-- 主行名+标签 / 次行包名·版本 -->
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                      <Border Style="{StaticResource AppTag}"
                              Visibility="{Binding ShowLauncherTag, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Launcher" Style="{StaticResource AppTagText}" />
                      </Border>
                      <Border CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.AccentMuted}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.WarningBg}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock FontSize="11" FontWeight="Medium" Text="{Binding KindLabel}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.WarningText}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding MetaLine}" Margin="0,2,0,0" FontSize="11"
                               FontFamily="{DynamicResource Font.Mono}"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <!-- 行尾操作：启动 / 强制停止 / 清数据 / 授权 / 卸载 -->
                  <Grid Grid.Column="4" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="32" />
                      <ColumnDefinition Width="4" />
                      <ColumnDefinition Width="32" />
                      <ColumnDefinition Width="4" />
                      <ColumnDefinition Width="32" />
                      <ColumnDefinition Width="4" />
                      <ColumnDefinition Width="32" />
                      <ColumnDefinition Width="4" />
                      <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource Button.Icon}" ToolTip="打开应用" AutomationProperties.Name="打开应用"
                            Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}">
                      <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16"
                                      Content="{StaticResource Icon.Action.Launch}" />
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource Button.Icon}" ToolTip="强制停止" AutomationProperties.Name="强制停止"
                            Command="{Binding DataContext.ForceStopCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}">
                      <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16"
                                      Content="{StaticResource Icon.Action.ForceStop}" />
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource Button.Icon}" ToolTip="清理应用数据" AutomationProperties.Name="清理应用数据"
                            Command="{Binding DataContext.ClearDataCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}">
                      <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16"
                                      Content="{StaticResource Icon.Action.ClearData}" />
                    </Button>
                    <Button Grid.Column="6" Style="{StaticResource RowAction.ThirdPartyOnly}" ToolTip="一键授权" AutomationProperties.Name="一键授权"
                            Command="{Binding DataContext.GrantAllCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}">
                      <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16"
                                      Content="{StaticResource Icon.Action.Grant}" />
                    </Button>
                    <Button Grid.Column="8" Style="{StaticResource RowAction.ThirdPartyOnlyDanger}" ToolTip="卸载" AutomationProperties.Name="卸载"
                            Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}">
                      <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16"
                                      Content="{StaticResource Icon.Action.Uninstall}" />
                    </Button>
                  </Grid>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="没有符合条件的应用" FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
            <TextBlock Text="试试切换筛选或清除搜索词" Margin="0,6,0,0" FontSize="12"
                       HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
          </StackPanel>

          <!-- 加载对话框：暗色遮罩 + Surface 卡片，避免字色与半透明底对比不足 -->
          <Border Background="#B00F141C" CornerRadius="6" Panel.ZIndex="20"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Width="360" MinHeight="120" Padding="24,22"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="10">
              <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.35" Direction="270" />
              </Border.Effect>
              <StackPanel>
                <TextBlock Text="{Binding LoadingMessage}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding BusyDetail}" Margin="0,8,0,0" FontSize="12"
                           Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
                <ProgressBar Margin="0,16,0,0" Height="6" IsIndeterminate="True"
                             Foreground="{DynamicResource Brush.Accent}" />
              </StackPanel>
            </Border>
          </Border>
        </Grid>
      </Border>
    </DockPanel>
  </DockPanel>
</UserControl>
