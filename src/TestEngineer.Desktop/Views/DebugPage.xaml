<UserControl x:Class="TestEngineer.Desktop.Views.DebugPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TestEngineer.Desktop.ViewModels">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>

  <Grid>
    <DockPanel>
      <!-- 页头：无主操作钮 -->
      <Border DockPanel.Dock="Top" Padding="16,12,16,10"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
        <StackPanel>
          <TextBlock Text="调试指令" Style="{StaticResource Text.PageTitle}" />
          <TextBlock Text="快捷操作 · 结果弹窗 · 作用于当前设备"
                     Style="{StaticResource Text.PageSubtitle}" />
          <StackPanel Margin="0,10,0,0"
                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
              <Button DockPanel.Dock="Right" Content="取消" Margin="12,0,0,0"
                      Style="{StaticResource Button.Secondary}" MinWidth="64" Height="26"
                      Command="{Binding CancelRunningTaskCommand}"
                      AutomationProperties.Name="取消当前指令" />
              <TextBlock Text="{Binding TaskTitle}" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <ProgressBar Margin="0,8,0,0" Height="6" Minimum="0" Maximum="100"
                         Style="{StaticResource ProgressBar.Meter}"
                         IsIndeterminate="{Binding TaskIndeterminate}"
                         Value="{Binding TaskProgress}"
                         Foreground="{DynamicResource Brush.Accent}" />
            <TextBlock Text="{Binding TaskDetail}" Margin="0,6,0,0" FontSize="12"
                       FontFamily="{DynamicResource Font.Mono}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 页体：168px 分类轨 | 1fr 指令列表，间距 10，最小高 440 -->
      <Grid Margin="16,12,16,16" MinHeight="440">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="168" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 分类轨 -->
        <ItemsControl Grid.Column="0" ItemsSource="{Binding Categories}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:DebugCategoryItem}">
              <Button Content="{Binding Label}" Style="{StaticResource Button.Category}"
                      Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding Key}"
                      Selector.IsSelected="{Binding IsSelected, Mode=OneWay}"
                      AutomationProperties.Name="{Binding Label}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 指令列表 panel padding:0 -->
        <Border Grid.Column="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6"
                Padding="0">
          <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding FilteredCommands}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:DebugCommandItemViewModel}">
                    <Border Padding="12,10"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                      <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Margin="12,0,0,0"
                                Content="{Binding ActionLabel}"
                                Style="{StaticResource Button.Primary}"
                                MinWidth="64" Height="32"
                                IsEnabled="{Binding IsEnabled}"
                                ToolTip="{Binding DisabledReason}"
                                Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding ActionLabel}" />
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                     Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding CommandSummary}" Margin="0,3,0,0"
                                     FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                                     Foreground="{DynamicResource Brush.TextSecondary}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="此分类暂无指令" Panel.ZIndex="1"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"
                       Visibility="{Binding IsEmptyCategory, Converter={StaticResource BoolToVis}}" />
          </Grid>
        </Border>
      </Grid>
    </DockPanel>
  </Grid>
</UserControl>
