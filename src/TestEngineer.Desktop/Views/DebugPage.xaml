<UserControl x:Class="TestEngineer.Desktop.Views.DebugPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,12,16,10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel>
          <TextBlock Text="调试指令" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Status}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBox Width="180" Height="32" Margin="0,0,8,0" VerticalContentAlignment="Center" Padding="8,0"
                   Text="{Binding MonkeyPackage, UpdateSourceTrigger=PropertyChanged}" ToolTip="Monkey 包名" />
          <TextBox Width="48" Height="32" Margin="0,0,8,0" VerticalContentAlignment="Center" Padding="4,0"
                   Text="{Binding MonkeyMinutes}" ToolTip="分钟" />
          <Button Content="应用 Monkey" Margin="0,0,8,0" Command="{Binding RunMonkeyAppCommand}" />
          <Button Content="导出日志" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" Command="{Binding ExportLogcatCommand}"
                  ToolTip="导出 logcat -d 为 ZIP（含 logcat.txt / meta.txt）" />
          <Button Content="bugreport" Style="{StaticResource Button.Primary}" Command="{Binding ExportBugreportCommand}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Margin="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ListBox Grid.Column="0" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="0,0,10,0" />

      <ListBox Grid.Column="1" ItemsSource="{Binding FilteredCommands}" Margin="0,0,10,0"
               MouseDoubleClick="OnCommandDoubleClick">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="4">
              <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
              <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Description}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Column="2" Background="{DynamicResource Brush.Console}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="8">
        <ScrollViewer>
          <TextBox Text="{Binding Output}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                   Foreground="{DynamicResource Brush.ConsoleText}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                   TextWrapping="Wrap" AcceptsReturn="True" />
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
