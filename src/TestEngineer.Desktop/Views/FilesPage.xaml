<UserControl x:Class="TestEngineer.Desktop.Views.FilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="OnDrop"
             DragOver="OnDragOver"
             Loaded="OnLoaded">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,12,16,10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel>
          <TextBlock Text="文件管理" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Status}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
          <TextBlock Text="{Binding ClipboardSummary}" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="缺陷证据包" Margin="0,0,8,0" Style="{StaticResource Button.Primary}" Command="{Binding ExportEvidencePackCommand}"
                  ToolTip="截屏 + logcat + 设备摘要 + 已选远程文件 → ZIP" />
          <Button Content="系统信息" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" Command="{Binding ExportSystemInfoCommand}"
                  ToolTip="导出 DeviceSnapshot 为 UTF-8 txt（可选 zip）" />
          <Button Content="导入" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" Command="{Binding ImportLocalCommand}" />
          <Button Content="导出已选" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" Command="{Binding ExportSelectionCommand}" />
          <Button Content="刷新" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Margin="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,10,0">
        <Button Content="内部存储" Padding="10" Margin="0,0,0,4" HorizontalContentAlignment="Left" Height="32"
                Command="{Binding UseSdcardCommand}" />
        <Button Content="根目录 /" Padding="10" HorizontalContentAlignment="Left" Height="32"
                Command="{Binding UseRootCommand}" />
        <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                   Text="{Binding SelectionSummary}" TextWrapping="Wrap" />
        <Button Margin="0,8,0,0" Content="清空选择" Command="{Binding ClearSelectionCommand}" Padding="8,4" Height="28" />
        <Button Margin="0,8,0,0" Content="粘贴到此" Command="{Binding PasteCommand}" Padding="8,4" Height="28" />
        <Button Margin="0,12,0,0" Content="缺陷证据包" Command="{Binding ExportEvidencePackCommand}" Padding="8,4" Height="28"
                ToolTip="无选中时仍含 screencap/logcat/摘要" />
        <Button Margin="0,4,0,0" Content="系统信息" Command="{Binding ExportSystemInfoCommand}" Padding="8,4" Height="28" />
        <TextBlock Margin="0,16,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                   Text="可将本机文件拖入列表上传到当前目录。" />
      </StackPanel>

      <DockPanel Grid.Column="1">
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Breadcrumbs}" Margin="0,0,0,8">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                <Button Content="{Binding Name}" Padding="4,0" BorderThickness="0" Background="Transparent"
                        Foreground="{DynamicResource Brush.Accent}" Cursor="Hand"
                        Command="{Binding DataContext.GoBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Path}" />
                <TextBlock Text="/" Margin="2,0" Foreground="{DynamicResource Brush.TextSecondary}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
          <ListBox x:Name="FileList"
                   ItemsSource="{Binding Entries}"
                   SelectedItem="{Binding FocusedEntry}"
                   BorderThickness="0" Background="Transparent"
                   MouseDoubleClick="OnDoubleClick"
                   PreviewMouseMove="OnListPreviewMouseMove"
                   PreviewMouseLeftButtonDown="OnListPreviewMouseLeftButtonDown">
            <ListBox.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="复制" Command="{Binding CopyCommand}"
                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="剪切" Command="{Binding CutCommand}"
                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="粘贴" Command="{Binding PasteCommand}" />
                <Separator />
                <MenuItem Header="删除" Command="{Binding DeleteCommand}"
                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="导出到目录…" Command="{Binding ExportSelectionCommand}" />
                <MenuItem Header="进入目录" Command="{Binding EnterCommand}"
                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="100" />
                  </Grid.ColumnDefinitions>
                  <CheckBox VerticalAlignment="Center"
                            Command="{Binding DataContext.ToggleSelectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                             Text="{Binding Mode}" FontFamily="Cascadia Mono, Consolas" />
                  <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" Text="{Binding Size}" />
                  <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Border Padding="4,1" CornerRadius="4" Margin="0,0,4,0"
                            Background="#291F7A4C" Visibility="{Binding CanWrite, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="可写" FontSize="10" Foreground="{DynamicResource Brush.Success}" />
                    </Border>
                    <Button Content="进入" Padding="6,2" Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}"
                            Command="{Binding DataContext.EnterCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
