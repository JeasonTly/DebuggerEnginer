<Window x:Class="TestEngineer.Desktop.Views.CommandResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title, RelativeSource={RelativeSource Self}}"
        Icon="pack://application:,,,/Assets/AppIcon.png"
        Width="640" Height="440" MinWidth="420" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="{DynamicResource Font.Ui}">
  <DockPanel Margin="0">
    <Border DockPanel.Dock="Bottom" Padding="12,10"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
            Background="{DynamicResource Brush.Surface}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="复制" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" Click="OnCopyClick"
                AutomationProperties.Name="复制输出" />
        <Button Content="关闭" Style="{StaticResource Button.Primary}" IsDefault="True" Click="OnCloseClick"
                AutomationProperties.Name="关闭" />
      </StackPanel>
    </Border>

    <Border Margin="12" Background="{DynamicResource Brush.Console}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
      <ScrollViewer x:Name="OutputScroll"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    Padding="12,10">
        <!-- TextBlock + NoWrap：等宽左对齐，避免 TextBox 自动换行导致「没对齐」观感 -->
        <TextBlock x:Name="OutputBlock"
                   FontFamily="{DynamicResource Font.Mono}"
                   FontSize="12"
                   LineHeight="18"
                   LineStackingStrategy="BlockLineHeight"
                   Foreground="{DynamicResource Brush.ConsoleText}"
                   TextAlignment="Left"
                   HorizontalAlignment="Left"
                   TextWrapping="NoWrap"
                   xml:space="preserve" />
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
