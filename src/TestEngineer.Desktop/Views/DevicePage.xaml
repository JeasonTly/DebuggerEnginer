<UserControl x:Class="TestEngineer.Desktop.Views.DevicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TestEngineer.Desktop.Converters">
  <UserControl.Resources>
    <conv:NullToDashConverter x:Key="Dash" />
    <conv:BytesToGiBConverter x:Key="GiB" />
    <conv:UsedRatioConverter x:Key="UsedRatio" />
    <conv:AvailableToUsedRatioConverter x:Key="AvailableToUsedRatio" />
  </UserControl.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,12,16,10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel>
          <TextBlock Text="设备信息" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Status}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
        </StackPanel>
        <Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource Button.Primary}"
                Command="{Binding RefreshCommand}"
                HorizontalAlignment="Right" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <UniformGrid Columns="3" Margin="0,0,0,12">
          <Border Margin="0,0,12,0" Padding="12" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
            <StackPanel>
              <TextBlock Text="电量" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" />
              <TextBlock FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0">
                <Run Text="{Binding Snapshot.BatteryLevel, TargetNullValue=—}" /><Run Text="%" />
              </TextBlock>
              <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Snapshot.BatteryStatus, Converter={StaticResource Dash}}" />
              <ProgressBar Style="{StaticResource ProgressBar.Meter}" Margin="0,8,0,0"
                           Value="{Binding Snapshot.BatteryLevel, Mode=OneWay, TargetNullValue=0}" />
            </StackPanel>
          </Border>
          <Border Margin="0,0,12,0" Padding="12" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
            <StackPanel>
              <TextBlock Text="存储 /data" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" />
              <TextBlock FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"
                         Text="{Binding Snapshot.StorageUsedBytes, Converter={StaticResource GiB}}" />
              <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}">
                <Run Text="共 " /><Run Text="{Binding Snapshot.StorageTotalBytes, Converter={StaticResource GiB}}" />
              </TextBlock>
              <ProgressBar Style="{StaticResource ProgressBar.Meter}" Margin="0,8,0,0">
                <ProgressBar.Value>
                  <MultiBinding Converter="{StaticResource UsedRatio}" Mode="OneWay">
                    <Binding Path="Snapshot.StorageUsedBytes" />
                    <Binding Path="Snapshot.StorageTotalBytes" />
                  </MultiBinding>
                </ProgressBar.Value>
              </ProgressBar>
            </StackPanel>
          </Border>
          <Border Padding="12" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
            <StackPanel>
              <TextBlock Text="内存" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" />
              <TextBlock FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"
                         Text="{Binding Snapshot.MemoryAvailableBytes, Converter={StaticResource GiB}}" />
              <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}">
                <Run Text="可用 / 共 " /><Run Text="{Binding Snapshot.MemoryTotalBytes, Converter={StaticResource GiB}}" />
              </TextBlock>
              <ProgressBar Style="{StaticResource ProgressBar.Meter}" Margin="0,8,0,0">
                <ProgressBar.Value>
                  <MultiBinding Converter="{StaticResource AvailableToUsedRatio}" Mode="OneWay">
                    <Binding Path="Snapshot.MemoryAvailableBytes" />
                    <Binding Path="Snapshot.MemoryTotalBytes" />
                  </MultiBinding>
                </ProgressBar.Value>
              </ProgressBar>
            </StackPanel>
          </Border>
        </UniformGrid>

        <Border Padding="12" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="型号" />
            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,12,8" FontSize="12" FontFamily="Cascadia Mono, Consolas" Text="{Binding Snapshot.Model, Converter={StaticResource Dash}}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="Android" />
            <TextBlock Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" FontSize="12" FontFamily="Cascadia Mono, Consolas" Text="{Binding Snapshot.AndroidVersion, Converter={StaticResource Dash}}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="构建类型" />
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,12,8" FontSize="12" FontFamily="Cascadia Mono, Consolas" Text="{Binding Snapshot.BuildType, Converter={StaticResource Dash}}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="分辨率" />
            <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,0,0,8" FontSize="12" FontFamily="Cascadia Mono, Consolas" Text="{Binding Snapshot.Resolution}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="内核" />
            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,12,8" FontSize="12" FontFamily="Cascadia Mono, Consolas" Text="{Binding Snapshot.Kernel, Converter={StaticResource Dash}}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="基带" />
            <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,0,0,8" FontSize="12" FontFamily="Cascadia Mono, Consolas" Text="{Binding Snapshot.Baseband, Converter={StaticResource Dash}}" TextWrapping="Wrap" />

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="安全补丁" />
            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,12,8" FontSize="12" FontFamily="Cascadia Mono, Consolas" Text="{Binding Snapshot.SecurityPatch, Converter={StaticResource Dash}}" />
            <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="CPU" />
            <TextBlock Grid.Row="3" Grid.Column="3" Margin="0,0,0,8" FontSize="12" FontFamily="Cascadia Mono, Consolas" Text="{Binding Snapshot.CpuModel, Converter={StaticResource Dash}}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="网络类型" />
            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,12,8" FontSize="12" FontFamily="Cascadia Mono, Consolas" Text="{Binding Snapshot.NetworkType, Converter={StaticResource Dash}}" />
            <TextBlock Grid.Row="4" Grid.Column="2" Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="IP" />
            <TextBlock Grid.Row="4" Grid.Column="3" Margin="0,0,0,8" FontSize="12" FontFamily="Cascadia Mono, Consolas" Text="{Binding Snapshot.IpAddress, Converter={StaticResource Dash}}" />

            <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="Wi‑Fi SSID" />
            <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,0,12,8" FontSize="12" FontFamily="Cascadia Mono, Consolas" Text="{Binding Snapshot.WifiSsid, Converter={StaticResource Dash}}" />
            <TextBlock Grid.Row="5" Grid.Column="2" Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="Wi‑Fi MAC" />
            <TextBlock Grid.Row="5" Grid.Column="3" Margin="0,0,0,8" FontSize="12" FontFamily="Cascadia Mono, Consolas" Text="{Binding Snapshot.WifiMac, Converter={StaticResource Dash}}" />

            <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="运行时间" />
            <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" FontFamily="Cascadia Mono, Consolas"
                       FontSize="20" FontWeight="SemiBold" Text="{Binding UptimeText}" />
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
