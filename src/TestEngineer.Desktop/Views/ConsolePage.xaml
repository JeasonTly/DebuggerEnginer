<UserControl x:Class="TestEngineer.Desktop.Views.ConsolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,12,16,10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <StackPanel>
        <TextBlock Text="控制台" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Status}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
      </StackPanel>
    </Border>

    <DockPanel Margin="16">
      <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Chips}" Margin="0,0,0,8">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding Title}" Margin="0,0,6,6" Style="{StaticResource Button.Chip}"
                    Command="{Binding DataContext.UseChipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
          <Button Content="运行" Width="72" Height="32" Margin="0,0,8,0" Style="{StaticResource Button.Primary}" Command="{Binding RunCommand}" />
          <Button Content="中止" Width="64" Height="32" Margin="0,0,8,0" Command="{Binding CancelCommand}" />
          <Button Content="清屏" Width="64" Height="32" Margin="0,0,8,0" Command="{Binding ClearOutputCommand}" />
          <Button Content="清历史" Width="72" Height="32" Style="{StaticResource Button.Danger}" Command="{Binding ClearHistoryCommand}" />
        </StackPanel>
        <TextBox Height="32" VerticalContentAlignment="Center" Padding="8,0"
                 FontFamily="Cascadia Mono, Consolas" FontSize="14"
                 Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                 PreviewKeyDown="OnInputPreviewKeyDown" />
      </DockPanel>

      <Border Background="{DynamicResource Brush.Console}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBox Text="{Binding Output}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                   Foreground="{DynamicResource Brush.ConsoleText}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                   TextWrapping="Wrap" AcceptsReturn="True" />
        </ScrollViewer>
      </Border>
    </DockPanel>
  </DockPanel>
</UserControl>
