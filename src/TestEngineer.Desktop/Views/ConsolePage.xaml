<UserControl x:Class="TestEngineer.Desktop.Views.ConsolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <!-- 输出区背景固定黑色。自绘模板，避免 WPF-UI 在聚焦、滚动时把底色刷成白。 -->
    <Style x:Key="Console.OutputBox" TargetType="TextBox">
      <Setter Property="Background" Value="#000000" />
      <Setter Property="Foreground" Value="#E6EDF3" />
      <Setter Property="CaretBrush" Value="#E6EDF3" />
      <Setter Property="SelectionBrush" Value="#264F78" />
      <Setter Property="SelectionTextBrush" Value="#E6EDF3" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="#000000" SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            Background="#000000"
                            Focusable="False"
                            VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                            HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 深色底 + 浅色字；自绘模板避免 WPF-UI 聚焦白底盖掉文字 -->
    <Style x:Key="Console.InputBox" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Brush.ConsoleInput}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.ConsoleInputText}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Brush.ConsoleInputText}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Brush.AccentMuted}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="AcceptsReturn" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource Brush.Accent}"
                    BorderThickness="0"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled"
                            Focusable="False" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderThickness" Value="0,0,0,2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <DockPanel>
    <!-- 页头：清屏 Secondary、清除历史 Danger -->
    <Border DockPanel.Dock="Top" Padding="16,12,16,10"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel>
          <TextBlock Text="控制台" Style="{StaticResource Text.PageTitle}" />
          <TextBlock Text="自由 adb · 常用权限/日志快捷填入 · ↑↓ 历史"
                     Style="{StaticResource Text.PageSubtitle}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
          <Button Content="清屏" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}"
                  Command="{Binding ClearOutputCommand}"
                  AutomationProperties.Name="清屏" />
          <Button Content="清除历史" Style="{StaticResource Button.Danger}"
                  Command="{Binding ClearHistoryCommand}"
                  AutomationProperties.Name="清除历史" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Margin="16,12,16,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- console-chips：间距 6，下间距 10 -->
      <ItemsControl Grid.Row="0" ItemsSource="{Binding Chips}" Margin="0,0,0,10">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding Title}" Margin="0,0,6,6" Style="{StaticResource Button.Chip}"
                    ToolTip="{Binding Line}"
                    Command="{Binding DataContext.UseChipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Title}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 终端面板：填满剩余高度 -->
      <Border Grid.Row="1"
              Background="#000000"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
              CornerRadius="6" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- 自带滚动的只读 TextBox，便于拖选 / Ctrl+C 复制 -->
          <TextBox x:Name="OutputBox" Grid.Row="0"
                   Style="{StaticResource Console.OutputBox}"
                   Text="{Binding Output, Mode=OneWay}"
                   IsReadOnly="True"
                   IsReadOnlyCaretVisible="True"
                   Focusable="True"
                   TextWrapping="Wrap"
                   AcceptsReturn="True"
                   IsUndoEnabled="False"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.ScrollChanged="OnOutputScrollChanged"
                   AutomationProperties.Name="控制台输出（可选中复制）" />

          <!-- 输入行：$ | 输入 | 历史 | 运行 -->
          <Border Grid.Row="1" Padding="10,8"
                  Background="{DynamicResource Brush.ConsoleInput}"
                  BorderBrush="{DynamicResource Brush.ConsoleBorder}" BorderThickness="0,1,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="$" VerticalAlignment="Center"
                         FontFamily="{DynamicResource Font.Mono}"
                         Foreground="{DynamicResource Brush.AccentText}" />
              <Grid Grid.Column="2">
                <TextBox x:Name="InputBox" Style="{StaticResource Console.InputBox}"
                         Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsInputEnabled}"
                         ToolTip="{Binding InputToolTip}"
                         PreviewKeyDown="OnInputPreviewKeyDown"
                         AutomationProperties.Name="控制台输入" />
                <TextBlock Text="shell getprop ro.build.type" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="2,0,0,0"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                           Foreground="#8B97A8">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Input}" Value="">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Input}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
              <Button Grid.Column="4" Content="历史" Style="{StaticResource Button.Secondary}"
                      Command="{Binding ToggleHistoryCommand}"
                      AutomationProperties.Name="历史" />
              <Button Grid.Column="6" MinWidth="64"
                      Content="{Binding RunButtonLabel}"
                      Style="{StaticResource Button.Primary}"
                      PreviewMouseLeftButtonDown="OnRunPreviewDown"
                      Command="{Binding RunOrCancelCommand}"
                      AutomationProperties.Name="{Binding RunButtonLabel}" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- 历史面板：上间距 8，最大高 120 -->
      <Border Grid.Row="2" Margin="0,8,0,0" MaxHeight="120"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6"
              Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVis}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="暂无历史" Margin="10,8" FontSize="12"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Visibility="{Binding IsHistoryEmpty, Converter={StaticResource BoolToVis}}" />
            <ItemsControl ItemsSource="{Binding HistoryItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="10,6"
                          BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                          Cursor="Hand"
                          ToolTip="点击填入输入框"
                          MouseLeftButtonUp="OnHistoryItemClick">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.AccentMuted}" />
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="移除" Style="{StaticResource Button.Ghost}"
                              Height="24" Padding="8,2"
                              Command="{Binding DataContext.RemoveHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              ToolTip="从历史中删除此命令"
                              AutomationProperties.Name="移除历史命令"
                              PreviewMouseLeftButtonDown="OnHistoryRemovePreviewDown" />
                      <TextBlock Text="{Binding}" FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource Brush.Text}" />
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
