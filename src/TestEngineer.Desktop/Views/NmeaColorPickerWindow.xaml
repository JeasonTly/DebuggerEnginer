<Window x:Class="TestEngineer.Desktop.Views.NmeaColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轨迹颜色"
        Icon="pack://application:,,,/Assets/AppIcon.png"
        Width="560" Height="420" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="{DynamicResource Font.Ui}"
        ResizeMode="CanResize">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,14,16,10"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="全部随机" Style="{StaticResource Button.Ghost}"
                Command="{Binding RandomizeAllCommand}"
                AutomationProperties.Name="全部随机配色" />
        <StackPanel>
          <TextBlock Text="为每个有效文件指定 KML 轨迹颜色" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Text}" />
          <TextBlock Margin="0,4,0,0" FontSize="12"
                     Text="色板与 nmea_to_kml 对齐；随机时尽量互不重复"
                     Foreground="{DynamicResource Brush.TextSecondary}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="12,10"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Margin="0,0,8,0" MinWidth="72" Style="{StaticResource Button.Secondary}"
                IsCancel="True" Click="OnCancelClick" AutomationProperties.Name="取消" />
        <Button Content="确定" MinWidth="72" Style="{StaticResource Button.Primary}"
                IsDefault="True" Click="OnOkClick" AutomationProperties.Name="确定" />
      </StackPanel>
    </Border>

    <DataGrid Margin="12,10" ItemsSource="{Binding Rows}"
              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              CanUserReorderColumns="False" HeadersVisibility="Column"
              SelectionMode="Single" SelectionUnit="FullRow"
              GridLinesVisibility="Horizontal" RowHeaderWidth="0"
              Background="Transparent" BorderThickness="1"
              BorderBrush="{DynamicResource Brush.Border}"
              AlternationCount="2">
      <DataGrid.Columns>
        <DataGridTextColumn Header="文件" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True"
                            ElementStyle="{StaticResource {x:Type TextBlock}}" />
        <DataGridTemplateColumn Header="颜色" Width="200">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding Palette}"
                        SelectedItem="{Binding SelectedColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="4,2" VerticalContentAlignment="Center"
                        AutomationProperties.Name="选择轨迹颜色">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              Background="{Binding PreviewBrush}"
                              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                      <TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Brush.Text}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="" Width="72">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="随机" Style="{StaticResource Button.Ghost}" Margin="2,0"
                      Command="{Binding DataContext.RandomizeRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="随机颜色" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
