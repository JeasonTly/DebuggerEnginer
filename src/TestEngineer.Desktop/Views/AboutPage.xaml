<UserControl x:Class="TestEngineer.Desktop.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TestEngineer.Desktop.Converters">
  <UserControl.Resources>
    <conv:StringEqualsConverter x:Key="StrEq" />
  </UserControl.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,12,16,10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <StackPanel>
        <TextBlock Text="关于" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="主题与版本" Margin="0,4,0,0" FontSize="12"
                   Foreground="{DynamicResource Brush.TextSecondary}" />
      </StackPanel>
    </Border>

    <ScrollViewer Padding="16,12,16,16" VerticalScrollBarVisibility="Auto">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 外观 -->
        <Border Grid.Column="0" Padding="12"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
          <StackPanel>
            <TextBlock Text="外观" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
            <Border CornerRadius="6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    Background="{DynamicResource Brush.Raised}" Padding="2" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <Button Content="浅色" Margin="0,0,2,0" Style="{StaticResource Button.Segment}"
                        Tag="Light" Click="OnThemeSegmentClick"
                        Selector.IsSelected="{Binding SelectedTheme, Converter={StaticResource StrEq}, ConverterParameter=Light, Mode=OneWay}"
                        AutomationProperties.Name="浅色主题" />
                <Button Content="深色" Margin="0,0,2,0" Style="{StaticResource Button.Segment}"
                        Tag="Dark" Click="OnThemeSegmentClick"
                        Selector.IsSelected="{Binding SelectedTheme, Converter={StaticResource StrEq}, ConverterParameter=Dark, Mode=OneWay}"
                        AutomationProperties.Name="深色主题" />
                <Button Content="跟随系统" Style="{StaticResource Button.Segment}"
                        Tag="System" Click="OnThemeSegmentClick"
                        Selector.IsSelected="{Binding SelectedTheme, Converter={StaticResource StrEq}, ConverterParameter=System, Mode=OneWay}"
                        AutomationProperties.Name="跟随系统主题" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- 版本 -->
        <Border Grid.Column="2" Padding="12"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
          <StackPanel>
            <TextBlock Text="版本" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Image Width="40" Height="40" Source="pack://application:,,,/Assets/AppIcon.png"
                     RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
              <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="TestEngineer" FontWeight="SemiBold" />
                <TextBlock Text="{Binding VersionText}" FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
              </StackPanel>
            </StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="设计" />
              <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Margin="0,0,0,6"
                         Text="DESIGN.md · UI v1.5" />

              <TextBlock Grid.Row="1" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="投屏" />
              <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Margin="0,0,0,6"
                         Text="scrcpy（随包）" />

              <TextBlock Grid.Row="2" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="许可" />
              <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" TextWrapping="Wrap"
                         Text="第三方：adb（platform-tools）、scrcpy 及附带 FFmpeg/SDL；许可证见 tools/third-party。" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
