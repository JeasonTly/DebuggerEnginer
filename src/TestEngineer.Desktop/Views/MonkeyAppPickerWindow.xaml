<Window x:Class="TestEngineer.Desktop.Views.MonkeyAppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TestEngineer.Desktop.Converters"
        Title="选择应用"
        Icon="pack://application:,,,/Assets/AppIcon.png"
        Width="460" Height="560" MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="{DynamicResource Font.Ui}"
        ResizeMode="CanResize">
  <Window.Resources>
    <conv:PngBytesToImageConverter x:Key="PngImg" />
    <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,14,16,10"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <StackPanel>
        <TextBlock Text="全部应用，有图标的在前" FontSize="12"
                   Foreground="{DynamicResource Brush.TextSecondary}" />
        <TextBox x:Name="FilterBox" Margin="0,8,0,0" Height="32"
                 VerticalContentAlignment="Center" Padding="8,0"
                 TextChanged="OnFilterChanged"
                 ToolTip="按应用名或包名筛选" />
        <TextBlock x:Name="CountText" Margin="0,6,0,0" FontSize="11"
                   Foreground="{DynamicResource Brush.TextSecondary}" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="12,10"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Margin="0,0,8,0" MinWidth="72" Style="{StaticResource Button.Secondary}"
                IsCancel="True" Click="OnCancelClick" AutomationProperties.Name="取消" />
        <Button x:Name="OkButton" Content="确定" MinWidth="72" Style="{StaticResource Button.Primary}"
                IsDefault="True" IsEnabled="False" Click="OnOkClick" AutomationProperties.Name="确定" />
      </StackPanel>
    </Border>

    <ListBox x:Name="AppList" Margin="8" BorderThickness="0" Background="Transparent"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             SelectionChanged="OnSelectionChanged"
             MouseDoubleClick="OnListDoubleClick">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="4,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Raised}" ClipToBounds="True">
              <Grid>
                <Image Stretch="UniformToFill" Source="{Binding IconData, Converter={StaticResource PngImg}}" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="12"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           Text="{Binding Initial}"
                           Visibility="{Binding HasIcon, Converter={StaticResource InvBoolToVis}}" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding PackageName}" Margin="0,2,0,0" FontSize="11"
                         FontFamily="{DynamicResource Font.Mono}"
                         Foreground="{DynamicResource Brush.TextSecondary}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
