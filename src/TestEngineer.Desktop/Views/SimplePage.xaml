<UserControl x:Class="TestEngineer.Desktop.Views.SimplePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,12,16,10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <StackPanel>
        <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Subtitle, ElementName=Root}" Margin="0,4,0,0" FontSize="12"
                   Foreground="{DynamicResource Brush.TextSecondary}" />
      </StackPanel>
    </Border>
    <Border Margin="16" Padding="12" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
      <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
    </Border>
  </DockPanel>
</UserControl>
