<Window x:Class="TestEngineer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TestEngineer.Desktop.ViewModels"
        xmlns:views="clr-namespace:TestEngineer.Desktop.Views"
        xmlns:conv="clr-namespace:TestEngineer.Desktop.Converters"
        xmlns:ctrl="clr-namespace:TestEngineer.Desktop.Controls"
        Title="TestEngineer"
        Icon="pack://application:,,,/Assets/AppIcon.png"
        Width="1280" Height="800"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="14">
  <Window.Resources>
    <conv:NavWidthConverter x:Key="NavWidthConverter" />
    <conv:NavToggleTextConverter x:Key="NavToggleTextConverter" />
    <conv:NavLabelVisibilityConverter x:Key="NavLabelVisibility" />
    <conv:PageActiveConverter x:Key="PageActive" />
    <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <!-- 导航项：整行、圆角 6、最小高 36；图标列 20 宽距左缘 10（展开/折叠一致，左对齐）。 -->
    <Style x:Key="NavItemStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                    BorderBrush="Transparent" BorderThickness="2"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
          <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Trigger>
        <Trigger Property="Selector.IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.AccentMuted}" />
          <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        </Trigger>
        <!-- 折叠后内容槽要容得下 20px 图标，避免描边被排布宽度裁掉。 -->
        <DataTrigger Binding="{Binding DataContext.NavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter Property="Padding" Value="4,0" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NavLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Visibility" Value="{Binding DataContext.NavCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NavLabelVisibility}}" />
    </Style>
    <Style x:Key="NavToggleIcon" TargetType="ContentControl" BasedOn="{StaticResource Icon.Glyph}">
      <Setter Property="Content" Value="{StaticResource Icon.Nav.Collapse}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding DataContext.NavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter Property="Content" Value="{StaticResource Icon.Nav.Expand}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <DataTemplate DataType="{x:Type vm:DevicePageViewModel}">
      <views:DevicePage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AppsPageViewModel}">
      <views:AppsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:FilesPageViewModel}">
      <views:FilesPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DebugPageViewModel}">
      <views:DebugPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ConsolePageViewModel}">
      <views:ConsolePage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CastPageViewModel}">
      <views:CastPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DeveloperPageViewModel}">
      <views:DeveloperPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:NmeaPageViewModel}">
      <views:NmeaPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AboutPageViewModel}">
      <views:AboutPage />
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <DockPanel Margin="12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Width="18" Height="18" Margin="0,0,8,0" ToolTip="TestEngineer"
                 Source="pack://application:,,,/Assets/AppIcon.png"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 SnapsToDevicePixels="True" />
          <TextBlock Text="TestEngineer" FontWeight="SemiBold" VerticalAlignment="Center" />

          <!-- 设备切换芯片（对齐原型：点 + 型号·Android·通道 + build 标签 + ▾） -->
          <Grid Margin="16,0,0,0" VerticalAlignment="Center">
            <Button Padding="10,3" Cursor="Hand"
                    Command="{Binding ToggleDeviceMenuCommand}"
                    ToolTip="切换设备" AutomationProperties.Name="切换设备"
                    Background="Transparent" BorderThickness="0">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="chip" Padding="{TemplateBinding Padding}" CornerRadius="6"
                          Background="{DynamicResource Brush.Raised}"
                          BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                          SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource Brush.TextSecondary}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
              <StackPanel Orientation="Horizontal">
                <Grid Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center">
                  <Ellipse Width="13" Height="13" Fill="{DynamicResource Brush.AccentMuted}">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ChipIsOnline}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                  <Ellipse Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource Brush.TextSecondary}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ChipIsOnline}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                </Grid>
                <TextBlock Text="{Binding ChipPrimaryText}" FontSize="12"
                           Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                  <TextBlock Text="{Binding ChipBuildTag}" FontSize="11"
                             Foreground="{DynamicResource Brush.TextSecondary}" />
                </Border>
                <TextBlock Margin="8,0,0,0" Text="▾" FontSize="11"
                           Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Popup IsOpen="{Binding IsDeviceMenuOpen, Mode=TwoWay}"
                   Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}"
                   AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                   HorizontalOffset="0" VerticalOffset="6">
              <Border MinWidth="320" Background="{DynamicResource Brush.Surface}"
                      BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6"
                      SnapsToDevicePixels="True">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Direction="270" />
                </Border.Effect>
                <DockPanel>
                  <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                    <DockPanel>
                      <TextBlock Text="已连接设备" FontSize="11" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Brush.TextSecondary}" />
                      <Button DockPanel.Dock="Right" Height="24" Padding="8,0" FontSize="12"
                              Style="{StaticResource Button.Ghost}" Content="刷新"
                              Command="{Binding RefreshDevicesCommand}"
                              AutomationProperties.Name="刷新设备" />
                    </DockPanel>
                  </Border>
                  <ItemsControl ItemsSource="{Binding DeviceMenuItems}">
                    <ItemsControl.Style>
                      <Style TargetType="ItemsControl">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding DeviceMenuItems.Count}" Value="0">
                            <Setter Property="Template">
                              <Setter.Value>
                                <ControlTemplate TargetType="ItemsControl">
                                  <TextBlock Margin="12,16" FontSize="12"
                                             Foreground="{DynamicResource Brush.TextSecondary}"
                                             Text="未检测到设备。请用 USB 连接并开启调试。" />
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:DeviceListItem}">
                        <Button HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                Padding="12,10" Cursor="Hand"
                                Command="{Binding DataContext.SelectDeviceFromMenuCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                          <Button.Template>
                            <ControlTemplate TargetType="Button">
                              <Border x:Name="row" Background="Transparent" Padding="{TemplateBinding Padding}"
                                      BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                                <ContentPresenter />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="row" Property="Background" Value="{DynamicResource Brush.AccentMuted}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                  <Setter TargetName="row" Property="Background" Value="{DynamicResource Brush.AccentMuted}" />
                                </DataTrigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Button.Template>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="14" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="7" Height="7" VerticalAlignment="Top" Margin="0,4,0,0">
                              <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                  <Setter Property="Fill" Value="{DynamicResource Brush.TextSecondary}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                      <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Ellipse.Style>
                            </Ellipse>
                            <StackPanel Grid.Column="1" Margin="8,0">
                              <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding ModelName}" />
                              <TextBlock FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource Brush.TextSecondary}">
                                <Run Text="Android "/><Run Text="{Binding AndroidVersion, Mode=OneWay}"/>
                                <Run Text=" · "/><Run Text="{Binding Channel, Mode=OneWay}"/>
                                <Run Text=" · "/><Run Text="{Binding BuildType, Mode=OneWay}"/>
                                <Run Text=" · "/><Run Text="{Binding StatusLabel, Mode=OneWay}"/>
                              </TextBlock>
                              <TextBlock FontSize="10" FontFamily="Cascadia Mono, Consolas" Margin="0,2,0,0"
                                         Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Serial}" />
                            </StackPanel>
                            <Border Grid.Column="2" VerticalAlignment="Center" Padding="6,1" CornerRadius="4"
                                    Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="当前" FontSize="11" Foreground="{DynamicResource Brush.AccentText}" />
                            </Border>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>
              </Border>
            </Popup>
          </Grid>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid x:Name="BodyGrid" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="NavColumn" Width="Auto" />
        <ColumnDefinition x:Name="WorkColumn" Width="*" MinWidth="300" />
        <ColumnDefinition x:Name="SplitterColumn" Width="5" />
        <ColumnDefinition x:Name="MirrorColumn" Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border x:Name="NavPane" Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0"
              Width="{Binding NavCollapsed, Converter={StaticResource NavWidthConverter}}"
              ClipToBounds="True"
              Visibility="{Binding IsMirrorFullscreen, Converter={StaticResource InvBoolToVis}}">
        <DockPanel Margin="8">
          <!-- 折叠键：仅矢量图标（左对齐）；文案只走 ToolTip / AutomationName -->
          <Button DockPanel.Dock="Top" Style="{StaticResource NavItemStyle}" Margin="0,0,0,4" MinHeight="32"
                  Command="{Binding ToggleNavCommand}"
                  ToolTip="{Binding NavCollapsed, Converter={StaticResource NavToggleTextConverter}}"
                  AutomationProperties.Name="{Binding NavCollapsed, Converter={StaticResource NavToggleTextConverter}}">
            <ContentControl Style="{StaticResource NavToggleIcon}" />
          </Button>
          <Button DockPanel.Dock="Bottom" Style="{StaticResource NavItemStyle}" ToolTip="关于" AutomationProperties.Name="关于"
                  Command="{Binding NavigateCommand}" CommandParameter="About"
                  Selector.IsSelected="{Binding CurrentPageViewModel, Converter={StaticResource PageActive}, ConverterParameter=About, Mode=OneWay}">
            <StackPanel Orientation="Horizontal">
              <ContentControl Style="{StaticResource Icon.Glyph}" Content="{StaticResource Icon.Nav.About}" />
              <TextBlock Style="{StaticResource NavLabel}" Text="关于" />
            </StackPanel>
          </Button>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        VerticalAlignment="Stretch">
          <StackPanel>
            <Button Style="{StaticResource NavItemStyle}" ToolTip="设备信息" AutomationProperties.Name="设备信息"
                    Command="{Binding NavigateCommand}" CommandParameter="Device"
                    Selector.IsSelected="{Binding CurrentPageViewModel, Converter={StaticResource PageActive}, ConverterParameter=Device, Mode=OneWay}">
              <StackPanel Orientation="Horizontal">
                <ContentControl Style="{StaticResource Icon.Glyph}" Content="{StaticResource Icon.Nav.Device}" />
                <TextBlock Style="{StaticResource NavLabel}" Text="设备信息" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource NavItemStyle}" ToolTip="应用管理" AutomationProperties.Name="应用管理"
                    Command="{Binding NavigateCommand}" CommandParameter="Apps"
                    Selector.IsSelected="{Binding CurrentPageViewModel, Converter={StaticResource PageActive}, ConverterParameter=Apps, Mode=OneWay}">
              <StackPanel Orientation="Horizontal">
                <ContentControl Style="{StaticResource Icon.Glyph}" Content="{StaticResource Icon.Nav.Apps}" />
                <TextBlock Style="{StaticResource NavLabel}" Text="应用管理" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource NavItemStyle}" ToolTip="文件管理" AutomationProperties.Name="文件管理"
                    Command="{Binding NavigateCommand}" CommandParameter="Files"
                    Selector.IsSelected="{Binding CurrentPageViewModel, Converter={StaticResource PageActive}, ConverterParameter=Files, Mode=OneWay}">
              <StackPanel Orientation="Horizontal">
                <ContentControl Style="{StaticResource Icon.Glyph}" Content="{StaticResource Icon.Nav.Files}" />
                <TextBlock Style="{StaticResource NavLabel}" Text="文件管理" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource NavItemStyle}" ToolTip="调试指令" AutomationProperties.Name="调试指令"
                    Command="{Binding NavigateCommand}" CommandParameter="Debug"
                    Selector.IsSelected="{Binding CurrentPageViewModel, Converter={StaticResource PageActive}, ConverterParameter=Debug, Mode=OneWay}">
              <StackPanel Orientation="Horizontal">
                <ContentControl Style="{StaticResource Icon.Glyph}" Content="{StaticResource Icon.Nav.Debug}" />
                <TextBlock Style="{StaticResource NavLabel}" Text="调试指令" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource NavItemStyle}" ToolTip="控制台" AutomationProperties.Name="控制台"
                    Command="{Binding NavigateCommand}" CommandParameter="Console"
                    Selector.IsSelected="{Binding CurrentPageViewModel, Converter={StaticResource PageActive}, ConverterParameter=Console, Mode=OneWay}">
              <StackPanel Orientation="Horizontal">
                <ContentControl Style="{StaticResource Icon.Glyph}" Content="{StaticResource Icon.Nav.Console}" />
                <TextBlock Style="{StaticResource NavLabel}" Text="控制台" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource NavItemStyle}" ToolTip="远程投屏" AutomationProperties.Name="远程投屏"
                    Command="{Binding NavigateCommand}" CommandParameter="Cast"
                    Selector.IsSelected="{Binding CurrentPageViewModel, Converter={StaticResource PageActive}, ConverterParameter=Cast, Mode=OneWay}">
              <StackPanel Orientation="Horizontal">
                <ContentControl Style="{StaticResource Icon.Glyph}" Content="{StaticResource Icon.Nav.Cast}" />
                <TextBlock Style="{StaticResource NavLabel}" Text="远程投屏" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource NavItemStyle}" ToolTip="开发者选项" AutomationProperties.Name="开发者选项"
                    Command="{Binding NavigateCommand}" CommandParameter="Developer"
                    Selector.IsSelected="{Binding CurrentPageViewModel, Converter={StaticResource PageActive}, ConverterParameter=Developer, Mode=OneWay}">
              <StackPanel Orientation="Horizontal">
                <ContentControl Style="{StaticResource Icon.Glyph}" Content="{StaticResource Icon.Nav.Developer}" />
                <TextBlock Style="{StaticResource NavLabel}" Text="开发者选项" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource NavItemStyle}" ToolTip="定位日志" AutomationProperties.Name="定位日志"
                    Command="{Binding NavigateCommand}" CommandParameter="Nmea"
                    Selector.IsSelected="{Binding CurrentPageViewModel, Converter={StaticResource PageActive}, ConverterParameter=Nmea, Mode=OneWay}">
              <StackPanel Orientation="Horizontal">
                <ContentControl Style="{StaticResource Icon.Glyph}" Content="{StaticResource Icon.Nav.Nmea}" />
                <TextBlock Style="{StaticResource NavLabel}" Text="定位日志" />
              </StackPanel>
            </Button>
          </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Grid x:Name="WorkPane" Grid.Column="1" Background="{DynamicResource Brush.Background}" ClipToBounds="True"
            Visibility="{Binding IsMirrorFullscreen, Converter={StaticResource InvBoolToVis}}">
        <ContentControl x:Name="PageHost" Content="{Binding CurrentPageViewModel}">
          <ContentControl.RenderTransform>
            <TranslateTransform x:Name="PageHostSlide" />
          </ContentControl.RenderTransform>
        </ContentControl>
      </Grid>

      <GridSplitter x:Name="MirrorSplitter" Grid.Column="2" Width="5" HorizontalAlignment="Stretch"
                    Background="{DynamicResource Brush.Border}"
                    ResizeBehavior="PreviousAndNext"
                    Visibility="{Binding IsMirrorFullscreen, Converter={StaticResource InvBoolToVis}}" />

      <Border x:Name="MirrorPane" Grid.Column="3"
              Width="{Binding MirrorWidth}" MinWidth="240" MaxWidth="720"
              Background="{DynamicResource Brush.MirrorStage}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8">
            <StackPanel>
              <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                  <Button Margin="0,0,6,0" Style="{StaticResource Button.Primary}" Command="{Binding StartMirrorCommand}"
                          ToolTip="启动投屏" AutomationProperties.Name="启动投屏">
                    <StackPanel Orientation="Horizontal">
                      <ContentControl Style="{StaticResource Icon.Glyph}" Width="14" Height="14" Margin="0,0,6,0"
                                      Content="{StaticResource Icon.Mirror.Play}" />
                      <TextBlock Text="启动" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Margin="0,0,6,0" Style="{StaticResource Button.Secondary}" Command="{Binding StopMirrorCommand}"
                          ToolTip="停止投屏" AutomationProperties.Name="停止投屏">
                    <StackPanel Orientation="Horizontal">
                      <ContentControl Style="{StaticResource Icon.Glyph}" Width="14" Height="14" Margin="0,0,6,0"
                                      Content="{StaticResource Icon.Mirror.Stop}" />
                      <TextBlock Text="停止" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="MirrorFullscreenButton" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}"
                          Command="{Binding ToggleMirrorFullscreenCommand}"
                          ToolTip="{Binding MirrorFullscreenLabel}"
                          AutomationProperties.Name="{Binding MirrorFullscreenLabel}">
                    <StackPanel Orientation="Horizontal">
                      <ContentControl x:Name="MirrorFullscreenIcon" Style="{StaticResource Icon.Glyph}" Width="14" Height="14" Margin="0,0,6,0"
                                      Content="{StaticResource Icon.Mirror.Fullscreen}" />
                      <TextBlock Text="{Binding MirrorFullscreenLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <TextBlock Text="{Binding MirrorStatus}" VerticalAlignment="Center" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" TextAlignment="Right"
                           Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" />
              </DockPanel>
            </StackPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Surface}"
                  BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="8,6">
            <StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource Button.Icon}" Margin="0,0,4,0" ToolTip="返回" AutomationProperties.Name="返回"
                        Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_BACK">
                  <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16" Content="{StaticResource Icon.Mirror.Back}" />
                </Button>
                <Button Style="{StaticResource Button.Icon}" Margin="0,0,4,0" ToolTip="主页" AutomationProperties.Name="主页"
                        Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_HOME">
                  <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16" Content="{StaticResource Icon.Mirror.Home}" />
                </Button>
                <Button Style="{StaticResource Button.Icon}" Margin="0,0,4,0" ToolTip="近期任务" AutomationProperties.Name="近期任务"
                        Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_APP_SWITCH">
                  <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16" Content="{StaticResource Icon.Mirror.Recent}" />
                </Button>
                <Button Style="{StaticResource Button.Icon}" Margin="0,0,4,0" ToolTip="电源" AutomationProperties.Name="电源"
                        Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_POWER">
                  <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16" Content="{StaticResource Icon.Mirror.Power}" />
                </Button>
                <Button Style="{StaticResource Button.Icon}" Margin="0,0,4,0" ToolTip="截屏" AutomationProperties.Name="截屏"
                        Command="{Binding ScreenshotCommand}">
                  <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16" Content="{StaticResource Icon.Mirror.Screenshot}" />
                </Button>
                <Button Style="{StaticResource Button.Icon}"
                        ToolTip="{Binding RecordActionLabel}"
                        AutomationProperties.Name="{Binding RecordActionLabel}"
                        Command="{Binding StartMirrorRecordCommand}">
                  <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16" Content="{StaticResource Icon.Mirror.Record}" />
                </Button>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button Style="{StaticResource Button.Icon}" Margin="0,0,4,0" ToolTip="音量减" AutomationProperties.Name="音量减"
                        Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_VOLUME_DOWN">
                  <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16" Content="{StaticResource Icon.Mirror.VolumeDown}" />
                </Button>
                <Button Style="{StaticResource Button.Icon}" Margin="0,0,4,0" ToolTip="音量加" AutomationProperties.Name="音量加"
                        Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_VOLUME_UP">
                  <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16" Content="{StaticResource Icon.Mirror.VolumeUp}" />
                </Button>
                <Button Style="{StaticResource Button.Icon}" Margin="0,0,4,0" ToolTip="上" AutomationProperties.Name="上"
                        Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_DPAD_UP">
                  <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16" Content="{StaticResource Icon.Mirror.Up}" />
                </Button>
                <Button Style="{StaticResource Button.Icon}" Margin="0,0,4,0" ToolTip="下" AutomationProperties.Name="下"
                        Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_DPAD_DOWN">
                  <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16" Content="{StaticResource Icon.Mirror.Down}" />
                </Button>
                <Button Style="{StaticResource Button.Icon}" Margin="0,0,4,0" ToolTip="左" AutomationProperties.Name="左"
                        Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_DPAD_LEFT">
                  <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16" Content="{StaticResource Icon.Mirror.Left}" />
                </Button>
                <Button Style="{StaticResource Button.Icon}" ToolTip="右" AutomationProperties.Name="右"
                        Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_DPAD_RIGHT">
                  <ContentControl Style="{StaticResource Icon.Glyph}" Width="16" Height="16" Content="{StaticResource Icon.Mirror.Right}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border x:Name="MirrorStageBorder" Margin="8,4,8,8" Background="{DynamicResource Brush.MirrorStage}" CornerRadius="6"
                  BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True"
                  SizeChanged="OnMirrorStageSizeChanged">
            <Grid>
              <TextBlock x:Name="MirrorPlaceholder"
                         Text="右侧常驻投屏区&#x0a;点击「启动投屏」嵌入 scrcpy"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
              <ctrl:ScrcpyHwndHost x:Name="MirrorHost" Margin="0"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
              <Border x:Name="MirrorLoading" Visibility="Collapsed" Background="#C00A0E14" Panel.ZIndex="4">
                <Border MaxWidth="220" Margin="12" Padding="18,16" MinHeight="96"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="10">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.35" Direction="270" />
                  </Border.Effect>
                  <StackPanel>
                    <TextBlock Text="正在加载投屏" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
                    <ProgressBar Margin="0,14,0,0" Height="6" IsIndeterminate="True"
                                 Style="{StaticResource ProgressBar.Meter}"
                                 Foreground="{DynamicResource Brush.Accent}" />
                  </StackPanel>
                </Border>
              </Border>
            </Grid>
          </Border>
        </DockPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
      <TextBlock Margin="12,0" VerticalAlignment="Center" FontSize="11"
                 Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding StatusText}" />
    </Border>
  </Grid>
</Window>
