    },
    {
      "id": "wm-density-reset",
      "category": "显示按键",
      "title": "重置密度",
      "description": "wm density reset",
      "args": ["shell", "wm", "density", "reset"],
      "silent": true,
      "timeoutSeconds": 15
    },
    {
      "id": "monkey-app",
      "category": "Monkey",
      "title": "应用 Monkey（按时长）",
      "description": "从全部应用中选择，有图标的排在前面。",
      "kind": "monkey-app",
      "dangerous": true,
      "timeoutSeconds": 3600
    },
    {
      "id": "monkey-system",
      "category": "Monkey",
      "title": "系统 Monkey（按时长）",
      "kind": "monkey-system",
      "dangerous": true,
      "timeoutSeconds": 3600
    },
    {
      "id": "monkey-stop",
      "category": "Monkey",
      "title": "停止 Monkey",
      "description": "结束设备上正在运行的 Monkey，包括不是本次启动的任务。",
      "kind": "monkey-stop",
      "timeoutSeconds": 20
    }
  ],
  "consoleChips": [
    { "id": "selinux-off", "title": "关闭 SELinux", "line": "shell setenforce 0", "requiresRoot": true, "dangerous": true },
    { "id": "selinux-get", "title": "查看 SELinux", "line": "shell getenforce", "requiresRoot": false },
    { "id": "selinux-on", "title": "恢复 SELinux", "line": "shell setenforce 1", "requiresRoot": true, "dangerous": true },
    { "id": "logcat-keyword", "title": "logcat 关键字", "kind": "logcat-filter" },
    { "id": "logcat-error", "title": "logcat *:E", "line": "logcat *:E" },
    { "id": "logcat-clear", "title": "logcat -c", "line": "logcat -c" },
