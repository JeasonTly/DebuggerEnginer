      "description": "KEYCODE_APP_SWITCH",
      "args": ["shell", "input", "keyevent", "KEYCODE_APP_SWITCH"],
      "silent": true,
      "timeoutSeconds": 10
    },
    {
      "id": "key-power",
      "category": "显示按键",
      "title": "电源键",
      "description": "KEYCODE_POWER",
      "args": ["shell", "input", "keyevent", "KEYCODE_POWER"],
      "silent": true,
      "timeoutSeconds": 10
    },
    {
      "id": "key-wakeup",
      "category": "显示按键",
