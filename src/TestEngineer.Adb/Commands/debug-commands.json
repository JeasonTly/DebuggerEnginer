      "description": "KEYCODE_WAKEUP",
      "args": ["shell", "input", "keyevent", "KEYCODE_WAKEUP"],
      "silent": true,
      "timeoutSeconds": 10
    },
    {
      "id": "wm-size",
      "category": "显示按键",
      "title": "查询分辨率",
      "description": "wm size",
      "args": ["shell", "wm", "size"],
      "timeoutSeconds": 10
    },
    {
      "id": "wm-density",
      "category": "显示按键",
      "title": "查询密度",
      "description": "wm density",
      "args": ["shell", "wm", "density"],
      "timeoutSeconds": 10
    },
    {
      "id": "wm-size-set",
      "category": "显示按键",
      "title": "设置分辨率",
      "description": "临时覆盖分辨率，如 720x1440。测完请重置。",
      "args": ["shell", "wm", "size", "{size}"],
      "dangerous": true,
      "silent": true,
      "timeoutSeconds": 15
    },
    {
      "id": "wm-size-reset",
      "category": "显示按键",
      "title": "重置分辨率",
      "description": "wm size reset",
